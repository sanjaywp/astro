add_action( 'wp_enqueue_scripts', 'bwe_enqueue_swatch_scripts' );
function bwe_enqueue_swatch_scripts() {
    wp_enqueue_script( 'jquery' );

    $custom_js = "
	jQuery(document).ready(function($){

		var variationsData = $('form.variations_form').data('product_variations');
		if (!variationsData) return;

		function getSelectedAttributes() {
			var selected = {};

			$('.bwe-variation-group').each(function(){
				var attr = $(this).data('attribute_name');

				var swatch = $(this).find('.bwe-swatch.active');
				var radio  = $(this).find('input[type=radio]:checked');

				if (swatch.length) {
					selected[attr] = swatch.data('value');
				} else if (radio.length) {
					selected[attr] = radio.val();
				}
			});

			return selected;
		}

		function updateAvailability() {

			var selected = getSelectedAttributes();

			$('.bwe-variation-group').each(function(){

				var currentAttr = $(this).data('attribute_name');

				$(this).find('.bwe-swatch, input[type=radio]').each(function(){

					var optionVal = $(this).data('value') || $(this).val();
					var isValid = false;

					variationsData.forEach(function(variation){

						var match = true;

						for (var attr in selected) {
							if (attr === currentAttr) continue;
							if (variation.attributes[attr] !== selected[attr]) {
								match = false;
								break;
							}
						}

						if (match && variation.attributes[currentAttr] === optionVal) {
							isValid = true;
						}
					});

					if (!isValid) {
						$(this)
							.addClass('disabled')
							.prop('disabled', true)
							.closest('.bwe-radio').addClass('disabled');
					} else {
						$(this)
							.removeClass('disabled')
							.prop('disabled', false)
							.closest('.bwe-radio').removeClass('disabled');
					}
				});
			});
		}

		// COLOR / IMAGE SWATCH CLICK
		$(document).on('click', '.bwe-swatch', function(){

			if ($(this).hasClass('disabled')) return;

			var value = $(this).data('value');
			var attr  = $(this).closest('.bwe-variation-group').data('attribute_name');

			$('select[name=\"' + attr + '\"]').val(value).trigger('change');

			$(this).closest('.bwe-variation-swatches')
				   .find('.bwe-swatch').removeClass('active');

			$(this).addClass('active');

			updateAvailability();
		});

		// RADIO CLICK
		$(document).on('change', '.bwe-variation-radios input[type=radio]', function(){

			if ($(this).prop('disabled')) return;

			var attr = $(this).closest('.bwe-variation-group').data('attribute_name');
			$('select[name=\"' + attr + '\"]').val($(this).val()).trigger('change');

			updateAvailability();
		});

	});";
    wp_add_inline_script( 'jquery', $custom_js );

    $custom_css = "
