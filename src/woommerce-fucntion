		$('.product-card').each(function(){
			let card = $(this);
			let product_id = card.data('product-id');

			$.post(woocommerce_params.ajax_url, {
				action: 'get_variations_data',
				product_id: product_id
			}, function(response){
				if (!response.success) return;
				let variations = response.data;
				card.on('click', '.attribute-button', function(){
					let selectedAttrVal = $(this).data("attr-value");
					let selectedAttrKey = $(this).closest('.product-attribute').data('attribute-key').toLowerCase();
					card.find('.attribute-button').each(function(){
						const targetAttrKey = $(this).closest('.product-attribute').data('attribute-key').toLowerCase();
						if (selectedAttrKey === targetAttrKey) return;
						$(this).removeClass('disabled');
						const isColorAvailable = variations.find(variation => variation.attributes[`attribute_${selectedAttrKey}`] === selectedAttrVal && variation.attributes[`attribute_${targetAttrKey}`] === $(this).data("attr-value"));
						if (!isColorAvailable) {
							$(this).addClass('disabled');
							$(this).removeClass('selected');
						}
					});
				});
			}, 'json');
		});
    });
    </script>
<?php });


