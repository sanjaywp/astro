    jQuery(function($){
        $(document).on("click", ".attribute-button", function(){
            const $btn = $(this), $wrap = $btn.closest(".attribute-options"), $card = $btn.closest(".product-card");
            $wrap.find(".attribute-button").removeClass("selected"); $btn.addClass("selected").removeClass("disabled");
            const key = $(this).closest('.product-attribute').data('attribute-key').toLowerCase(), val = $btn.data("attr-value");
            const map = $card.data("selectedAttributes") || {}; map[key] = val;
            $card.data("selectedAttributes", map);
        });

        function showMsg($card, text, isErr){
            $card.find('.mini-msg').text(text).removeClass('err ok').addClass(isErr ? 'err':'ok');
        }

        function sendToCart($btn, buyNow){
			const $card = $btn.closest(".product-card"),req = [];
			$card.find('.product-attribute').each(function(){
				const $attr = $(this);
				const key = $attr.data('attribute-key');

				const options = $attr.find('.attribute-button');

				if (options.length <= 1) {
					const $singleOption = options.eq(0);
					const selected = $card.data("selectedAttributes") || {};

					if (!selected[key]) {
						selected[key] = $singleOption.data("attr-value");
						$card.data("selectedAttributes", selected);

						options.removeClass('selected');
						$singleOption.addClass('selected');
					}

					return;
				}

				req.push(key);
			});

			const selected = $card.data("selectedAttributes") || {};
			for (let i = 0; i < req.length; i++){
				if (!selected[req[i]]) {
					showMsg($card, "Please select all options.", true);
					return;
				}
			}

			$.post("<?php echo esc_url(admin_url('admin-ajax.php')); ?>", {
				action: "custom_add_to_cart",
				_ajax_nonce: $card.find('.ajax-nonce').val(),
				product_id: $btn.data("product_id"),
				attributes: selected,
				buy_now: buyNow ? 1 : 0
			}).done(function(resp){
				if (resp.success && resp.data.redirect){
					window.location.href = resp.data.redirect;
				} else {
					showMsg($card, resp.data || "Error adding to cart.", true);
				}
			}).fail(function(){
				showMsg($card, "Request failed.", true);
			});
		}

        $(document).on("click",".add-to-cart-btn",function(e){ e.preventDefault(); sendToCart($(this),false); });
