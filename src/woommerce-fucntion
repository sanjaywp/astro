add_filter( 'woocommerce_package_rates', 'vikas_hide_flat_rate_if_free_shipping_active', 100, 2 );
function vikas_hide_flat_rate_if_free_shipping_active( $rates, $package ) {

    $flat_rate_id  = 'flat_rate:4';       // Your flat rate ID
    $free_rate_id  = 'free_shipping:5';   // Your free shipping ID

    // If free shipping exists, remove flat rate
    if ( isset( $rates[$free_rate_id] ) ) {
        if ( isset( $rates[$flat_rate_id] ) ) {
            unset( $rates[$flat_rate_id] );
        }
    }

    return $rates;
}

add_action( 'wp_ajax_get_variations_data', 'get_variations_data' );
add_action( 'wp_ajax_nopriv_get_variations_data', 'get_variations_data' );

function get_variations_data() {

    if ( empty($_POST['product_id']) ) {
        wp_send_json_error('Missing product ID');
    }

    $product = wc_get_product( intval($_POST['product_id']) );

    if (! $product || ! $product->is_type('variable')) {
        wp_send_json_error('Not a variable product');
    }

    $variations = [];

    foreach ($product->get_available_variations() as $var) {
        $variations[] = [
            'variation_id' => $var['variation_id'],
            'attributes'   => $var['attributes'],
            'is_active'    => $var['is_active']
        ];
    }

    wp_send_json_success( $variations );
}
