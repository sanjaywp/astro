add_action('woocommerce_before_add_to_cart_form', 'bwe_custom_variation_options', 20);
function bwe_custom_variation_options() {
    global $product;

    if ( ! $product || ! $product->is_type('variable') ) return;

    $attributes = $product->get_variation_attributes();
    $available_variations = $product->get_available_variations();
    $default_attributes = $product->get_default_attributes();

    foreach ( $attributes as $attribute_name => $options ) {
        $attribute_label = wc_attribute_label( $attribute_name );
        $sanitized_attr  = sanitize_title( $attribute_name );

        echo '<div class="bwe-variation-group" data-attribute_name="attribute_' . esc_attr( $sanitized_attr ) . '">';
        echo '<h4 class="font-semibold">' . esc_html( $attribute_label ) . '</h4>';

        if ( $sanitized_attr === 'color' ) {
            echo '<div class="bwe-variation-swatches">';
            $printed_colors = [];

            foreach ( $available_variations as $variation ) {
                $variation_id = $variation['variation_id'];
                $attr_value   = $variation['attributes']['attribute_' . $sanitized_attr];

                if ( ! $attr_value || in_array( $attr_value, $printed_colors, true ) ) continue;
                $printed_colors[] = $attr_value;

                $image_id = $variation['image_id'];
                if ( ! $image_id ) continue;

                $image_url  = wp_get_attachment_image_url( $image_id, 'thumbnail' );

                $active = '';
                if ( ( isset($default_attributes[$sanitized_attr]) && $default_attributes[$sanitized_attr] === $attr_value )
                     || count($options) === 1 ) {
                    $active = 'active';
                }

                echo '<div class="bwe-swatch-wrapper">';
                echo '<div class="bwe-swatch ' . $active . '" data-value="' . esc_attr($attr_value) . '">';
                echo '<img src="' . esc_url($image_url) . '" alt="' . esc_attr($attr_value) . '">';
                echo '</div>';
                echo '<span class="bwe-tooltip">' . esc_html($attr_value) . '</span>';
                echo '</div>';
            }
            echo '</div>';

        } elseif ( $sanitized_attr === 'size' ) {
            echo '<div class="bwe-variation-radios">';
            foreach ( $options as $option ) {
                $checked = '';
                if ( isset($default_attributes[$sanitized_attr]) && $default_attributes[$sanitized_attr] === $option ) {
                    $checked = 'checked';
                }
                echo '<label class="bwe-radio">';
                echo '<input type="radio" name="attribute_' . esc_attr( $sanitized_attr ) . '" value="' . esc_attr( $option ) . '" ' . $checked . '>';
                echo '<span>' . esc_html( $option ) . '</span>';
                echo '</label>';
            }
            echo '</div>';
        } else {
            echo '<div class="bwe-variation-radios">';
            foreach ( $options as $option ) {
                $checked = '';
                if ( isset($default_attributes[$sanitized_attr]) && $default_attributes[$sanitized_attr] === $option ) {
                    $checked = 'checked';
                }
                echo '<label class="bwe-radio">';
                echo '<input type="radio" name="attribute_' . esc_attr( $sanitized_attr ) . '" value="' . esc_attr( $option ) . '" ' . $checked . '>';
                echo '<span>' . esc_html( $option ) . '</span>';
                echo '</label>';
            }
            echo '</div>';
        }
        echo '</div>';
    }
}

