============================================================ */
add_action( 'wp_ajax_custom_add_to_cart', 'custom_add_to_cart_ajax' );
add_action( 'wp_ajax_nopriv_custom_add_to_cart', 'custom_add_to_cart_ajax' );

function custom_add_to_cart_ajax() {
    check_ajax_referer( 'custom_add_to_cart_nonce' );

    $product_id = absint( $_POST['product_id'] ?? 0 );
    $incoming   = (array) ( $_POST['attributes'] ?? [] );
    $buy_now    = ! empty( $_POST['buy_now'] );

    $product = wc_get_product( $product_id );
    if ( ! $product ) wp_send_json_error( 'Product not found.' );

    if ( $product->is_type('variable') ) {
        $required_map = $product->get_variation_attributes();
        $normalized   = [];
        foreach ( $required_map as $canon_key => $possible_vals ) {
			$transformedKey = strtolower(sanitize_title($canon_key));
            if ( empty( $incoming[$transformedKey] ) ) {
                wp_send_json_error( 'Please select all options.' );
            }
            $val = wp_unslash( $incoming[$transformedKey] );
            $normalized['attribute_'.$transformedKey] = $val;
        }
        $variation_id = $product->get_matching_variation( $normalized );
        if ( ! $variation_id ) wp_send_json_error( 'Variation not available.' );

        $added = WC()->cart->add_to_cart( $product_id, 1, $variation_id, $normalized );
    } else {
        $added = WC()->cart->add_to_cart( $product_id, 1 );
    }

    if ( ! $added ) wp_send_json_error( 'Could not add to cart.' );

    wp_send_json_success([
        'redirect' => $buy_now ? wc_get_checkout_url() : wc_get_cart_url()
    ]);
}

