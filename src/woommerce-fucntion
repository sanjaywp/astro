/* -------------------------------
 * 2) Register & enqueue an inline script (properly attached to a real handle)
 * ------------------------------- */
add_action( 'wp_enqueue_scripts', 'bwe_custom_qty_enqueue_script' );
function bwe_custom_qty_enqueue_script() {
    if ( ! is_product() ) {
        return;
    }

    // Register a handle that depends on jQuery and prints in footer (no external src)
    wp_register_script( 'bwe-custom-qty', false, array( 'jquery' ), '1.0', true );
    wp_enqueue_script( 'bwe-custom-qty' );

    // Inline JS — uses delegation and robust selectors
    $js = <<<JS
jQuery(function($){
    // delegated handler — works even if DOM is modified by other plugins/themes
    $(document).on('click', '.bwe-qty-btn', function(e){
        e.preventDefault();
        var \$btn = $(this);
        // find the closest custom wrapper then the qty input inside it
        var \$wrapper = \$btn.closest('.bwe-custom-quantity');
        var \$input = \$wrapper.find('input.qty');

        // if not found, try to find input in same form (fallback)
        if ( \$input.length === 0 ) {
            \$input = \$btn.closest('form.cart').find('input.qty').first();
        }

        if ( \$input.length === 0 ) {
            return; // nothing to do
        }

        // parse values safely
        var val = parseInt( \$input.val(), 10 );
        if ( isNaN(val) ) val = 0;
        var step = parseInt( \$input.attr('step'), 10 );
        if ( isNaN(step) || step <= 0 ) step = 1;
        var min = parseInt( \$input.attr('min'), 10 );
        if ( isNaN(min) ) min = 1;
        var maxAttr = \$input.attr('max');
        var max = ( typeof maxAttr !== 'undefined' && maxAttr !== '' ) ? parseInt( maxAttr, 10 ) : null;
        if ( max !== null && isNaN(max) ) max = null;

        if ( \$btn.hasClass('bwe-plus') ) {
            var next = val + step;
            if ( max === null || next <= max ) {
                \$input.val(next).trigger('change');
            }
        } else if ( \$btn.hasClass('bwe-minus') ) {
            var next2 = val - step;
            if ( next2 >= min ) {
                \$input.val(next2).trigger('change');
            } else if ( val > min ) {
                // ensure it doesn't go below min
                \$input.val(min).trigger('change');
            }
        }
    });
});
JS;

    wp_add_inline_script( 'bwe-custom-qty', $js );
}

